# Root .dockerignore for OmniSite SDSS Platform
# Prevents sensitive environment files and temporary build artifacts from entering Docker images

.env
.env.*
!.env.example

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/build/

# Git & Logs
.git/
.gitignore
**/*.log
scratch/
brain/
