# Root .dockerignore for OmniSite SDSS Platform
# Prevents sensitive environment files, documentation, test scripts, and temporary build artifacts from entering Docker images

# Sensitive Files
.env
.env.*
!.env.example

# Python virtual environment & cache
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/build/

# Git, Agents & Logs
.git/
.gitignore
**/*.log

# Reports, Scratch & Documentation artifacts (Not required for Docker runtime execution)
결과보고/
scratch/
brain/
.checkpoints/
.agents/

# Testing & inspection scripts
backend/app/scripts/test_*.py
backend/app/scripts/check_*.py
test_*.py
check_*.py

# Compressed archives (Crucial datasets zip files in Datasets/ are explicitly preserved for coldstart seeding)
*.zip
!Datasets/**/*.zip
!backend/data/**/*.zip
